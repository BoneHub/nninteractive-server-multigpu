# Settings for docker compose. Copy this file to .env (next to compose.yaml):
#   Linux:    cp .env.example .env
#   Windows:  copy .env.example .env
# then fill in the keys. Git ignores .env, so the keys stay on this machine.
#
# Every key is a random value of 16 to 128 letters and digits, and no two keys
# are the same. Make each one with
#   openssl rand -hex 16
# or, without openssl (e.g. on Windows):
#   docker run --rm nginx:stable openssl rand -hex 16

# Required. The key the proxy uses for all GPU containers. Users never see or
# need it.
INTERNAL_API_KEY=

# Required. The users of each GPU: one line per GPU service in compose.yaml,
#   GPU<number>_USER_KEYS=<key of a user>,<key of another user>,...
# with the GPU number of the service (nn0 -> GPU0_USER_KEYS). Every user gets
# their own key and always works on the GPU whose line holds it. A GPU serves
# one session per key at a time (its --max-sessions is the number of keys).
# The comment above each line is optional: it helps to remember whose key is whose.
# GPU 0: user 1, user 2
GPU0_USER_KEYS=
# GPU 1: user 3, user 4
GPU1_USER_KEYS=

# Optional. Port on this machine that users connect to (default 1527).
# To accept connections on one address only, put it in front, e.g. 127.0.0.1:1527
#PUBLIC_PORT=1527

# Optional. nnInteractive server image (default below). Pin a version tag for
# reproducible deployments; the available tags are listed in the upstream
# nnInteractive/inference/server/DOCKER.md.
#NN_IMAGE=ghcr.io/mic-dkfz/nninteractive-server:latest
