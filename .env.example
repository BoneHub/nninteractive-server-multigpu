# Settings for docker compose. Copy this file to .env (next to compose.yaml):
#   Linux:    cp .env.example .env
#   Windows:  copy .env.example .env
# then fill in the keys. Git ignores .env, so the keys stay on this machine.
#
# Every key is at most 128 letters and digits, and no two keys are the same.
# Make each one with
#   openssl rand -hex 16
# or, without openssl (e.g. on Windows):
#   docker run --rm nginx:stable openssl rand -hex 16
# Warning: there is no minimum length, but a short key (e.g. "alice") is easy to
# guess for anyone who can reach PUBLIC_PORT. Use short keys only when the port
# is reachable from trusted machines alone.

# Required. The key the proxy uses for all server containers. Users never see or
# need it.
INTERNAL_API_KEY=

# Required. The users of each GPU: one line per GPU,
#   GPU<number>_USER_KEYS=<key of a user>,<key of another user>,...
# with the GPU number that nvidia-smi -L shows. Every user gets their own key and
# their own server container, which always computes on the GPU whose line holds
# the key. Delete the lines of GPUs without users; add a line to use another GPU.
# After adding or removing keys or lines, run
#   docker compose run --rm configure
#   docker compose up -d --remove-orphans
# The comment above each line is optional: it helps to remember whose key is whose.
# GPU 0: user 1, user 2
GPU0_USER_KEYS=
# GPU 1: user 3, user 4
GPU1_USER_KEYS=

# Optional. How many sessions each user can have open at the same time
# (--max-sessions of their server container; default 1). One user's sessions
# never take another user's.
#MAX_SESSIONS_PER_USER=1

# Optional. Port on this machine that users connect to (default 1527).
# To accept connections on one address only, put it in front, e.g. 127.0.0.1:1527
#PUBLIC_PORT=1527

# Optional. nnInteractive server image (default below). Pin a version tag for
# reproducible deployments; the available tags are listed in the upstream
# nnInteractive/inference/server/DOCKER.md.
#NN_IMAGE=ghcr.io/mic-dkfz/nninteractive-server:latest
